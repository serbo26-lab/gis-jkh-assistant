{
  "manifest_version": 3,
  "name": "ГИС ЖКХ помощник",
  "version": "0.1.20",
  "description": "Связывает ГИС ЖКХ Ассистент с уже открытым личным кабинетом ГИС ЖКХ.",
  "permissions": [
    "alarms",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://lk.dom.gosuslugi.ru/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ГИС ЖКХ помощник"
  }
}
